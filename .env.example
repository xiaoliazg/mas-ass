# ============================================================
# mas-ass 环境变量配置模板
# 用法：cp .env.example .env  然后把占位值改成你自己的
# 注意：.env 已被 .gitignore 忽略，绝不会提交到仓库
# ============================================================

# --- 本地 vLLM（OpenAI 兼容端点）---
# vLLM 默认起在 8000 端口，如果你的启动端口不同，改这里
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=sk-your-local-key
# vLLM 里部署的模型名
VLLM_MODEL=agent-brain

# --- 各 Agent 的温度（研究/写作要高一点有创意，审核要低保证稳定）---
LLM_TEMPERATURE_WRITER=0.8
LLM_TEMPERATURE_REVIEWER=0

# --- 质量重试上限（审核不通过时，最多让写作 agent 重写几次）---
MAX_REVISION_ROUNDS=3
